APP_ENV=staging
PUBLIC_APP_URL=https://apflow-staging.example.com
API_PUBLIC_URL=https://api.apflow-staging.example.com
PUBLIC_APP_HOST=apflow-staging.example.com
API_PUBLIC_HOST=api.apflow-staging.example.com
CORS_ALLOWED_ORIGINS=https://apflow-staging.example.com
CADDY_ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+psycopg://apflow:replace-with-long-random-password@postgres:5432/apflow
USE_IN_MEMORY_REPOSITORIES=false
REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-long-minio-password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=apflow-invoices
DOCUMENT_STORAGE_PROVIDER=filesystem
DOCUMENT_STORAGE_PATH=/app/.storage/documents
MAX_INVOICE_UPLOAD_BYTES=10485760

OCR_PROVIDER=mock
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_TIMEOUT_SECONDS=60
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ERP_PROVIDER=mock
PRIORITY_ERP_MODE=mock
PRIORITY_ERP_BASE_URL=
PRIORITY_ERP_COMPANY=
PRIORITY_ERP_ENVIRONMENT=
PRIORITY_ERP_USERNAME=
PRIORITY_ERP_PASSWORD=
PRIORITY_ERP_API_KEY=
PRIORITY_ERP_TIMEOUT_SECONDS=15
PRIORITY_ERP_VERIFY_TLS=true
PRIORITY_ERP_VENDORS_ENTITY_NAME=
PRIORITY_ERP_PURCHASE_ORDERS_ENTITY_NAME=
PRIORITY_ERP_INVOICES_ENTITY_NAME=
EMAIL_PROVIDER=mock

AUTH_ENABLED=true
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_MODE=true
ALLOW_DEMO_MODE_IN_PRODUCTION=false
ALLOW_DEMO_RESET=false
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

NEXT_PUBLIC_API_BASE_URL=https://api.apflow-staging.example.com
