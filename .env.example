APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
PUBLIC_APP_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:8000
PUBLIC_APP_HOST=localhost
API_PUBLIC_HOST=api.localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CADDY_ACME_EMAIL=admin@example.com

DATABASE_URL=postgresql+psycopg://apflow:apflow@localhost:5432/apflow
USE_IN_MEMORY_REPOSITORIES=true
TESTING=false
POSTGRES_PASSWORD=apflow
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=apflow-invoices
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DOCUMENT_STORAGE_PROVIDER=memory
DOCUMENT_STORAGE_PATH=.storage/documents
MAX_INVOICE_UPLOAD_BYTES=10485760
# Docker Compose uses DOCUMENT_STORAGE_PROVIDER=filesystem and stores files under /app/.storage/documents.

OCR_PROVIDER=mock
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Set OCR_PROVIDER=ocr_space and provide OCR_SPACE_API_KEY to use OCR.space.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_FALLBACK_ENGINE=2
OCR_SPACE_ENABLE_ENGINE_FALLBACK=true
OCR_SPACE_TIMEOUT_SECONDS=60
# Set OCR_PROVIDER=azure and provide both values below to use real Azure Document Intelligence.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ERP_PROVIDER=mock
PRIORITY_ERP_MODE=mock
PRIORITY_ERP_BASE_URL=
PRIORITY_ERP_COMPANY=
PRIORITY_ERP_ENVIRONMENT=
PRIORITY_ERP_USERNAME=
PRIORITY_ERP_PASSWORD=
PRIORITY_ERP_API_KEY=
PRIORITY_ERP_TIMEOUT_SECONDS=15
PRIORITY_ERP_VERIFY_TLS=true
PRIORITY_ERP_ENABLE_WRITES=false
PRIORITY_ERP_READ_ONLY_FETCH_ENABLED=false
PRIORITY_ERP_MAX_PREVIEW_RECORDS=10
PRIORITY_ERP_VENDORS_ENTITY_NAME=
PRIORITY_ERP_PURCHASE_ORDERS_ENTITY_NAME=
PRIORITY_ERP_INVOICES_ENTITY_NAME=
PRIORITY_ERP_CLIENT_ID=
PRIORITY_ERP_CLIENT_SECRET=
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
SLACK_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

AUTH_ENABLED=false
AUTH_SECRET_KEY=dev-only-change-me-32-byte-minimum-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_MODE=true
ALLOW_DEMO_RESET=false
DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Docker Compose overrides DATABASE_URL to use the postgres service:
# postgresql+psycopg://apflow:apflow@postgres:5432/apflow
